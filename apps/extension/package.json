{
  "name": "@arklock/extension",
  "version": "1.55.0",
  "private": true,
  "type": "module",
  "description": "Arklock browser extension (Manifest V3): search, autofill, TOTP and password generator",
  "scripts": {
    "build": "node build.mjs all",
    "build:chromium": "node build.mjs chromium",
    "build:firefox": "node build.mjs firefox",
    "lint:firefox": "web-ext lint --source-dir dist-firefox --warnings-as-errors",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arklock/client": "1.55.0",
    "@arklock/contracts": "1.55.0",
    "@arklock/crypto": "1.55.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "vite": "^8.0.0",
    "web-ext": "^10.7.0"
  },
  "license": "AGPL-3.0-only"
}
