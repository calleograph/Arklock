# Arklock — пример конфигурации. Скопируйте в .env и задайте значения. Файл .env в git не попадает.

# Пароль PostgreSQL (обязателен). Сгенерировать: openssl rand -base64 32
POSTGRES_PASSWORD=

# Секрет приложения (не короче 32 символов). Используется для правдоподобных ответов на запросы о несуществующих
# учётных записях; ключом шифрования данных не является. Сгенерировать: openssl rand -base64 48
# Смена секрета безопасна, но делает ответы для несуществующих адресов другими.
APP_SECRET=

# Имя compose-проекта (меняйте, если на сервере несколько экземпляров)
COMPOSE_PROJECT_NAME=arklock

# Порт на loopback, куда обращается reverse proxy
APP_PORT=8080

# Сколько прокси стоит перед приложением (для корректного IP клиента)
TRUSTED_PROXY_HOPS=1

# Уровень журнала: fatal|error|warn|info|debug|trace
LOG_LEVEL=info

# Канал обновлений: stable|edge
UPDATE_CHANNEL=stable

# Метаданные сборки (задаёт скрипт сборки/обновления; вручную не менять)
# APP_VERSION=
# APP_GIT_COMMIT=
# APP_BUILT_AT=

# Адрес range API проверки скомпрометированных паролей (настраивается и в админке; появится в Ф6)
# COMPROMISE_RANGE_URL=https://api.pwnedpasswords.com/range/
