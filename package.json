{
  "name": "arklock",
  "version": "1.38.0",
  "private": true,
  "description": "Self-hosted team password manager with client-side encryption",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @arklock/crypto -w @arklock/contracts && npm run build -w @arklock/client && npm run build -w @arklock/api -w @arklock/web -w @arklock/cli -w @arklock/extension",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check:private": "node scripts/check-private-data.mjs",
    "test:e2e": "playwright test",
    "check:licenses": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.0",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "selenium-webdriver": "^4.51.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/calleograph/arklock.git"
  },
  "homepage": "https://github.com/calleograph/arklock",
  "bugs": {
    "url": "https://github.com/calleograph/arklock/issues"
  }
}
